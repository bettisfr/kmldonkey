    <width>550</width>
    <height>512</height>
   </rect>
  </property>
  <property name="windowTitle">
   <string>List Configuration</string>
  </property>
  <layout class="QVBoxLayout">
   <item>
    <widget class="QGroupBox" name="groupBox1">
     <property name="title">
      <string>Server List</string>
     </property>
     <layout class="QVBoxLayout" name="verticalLayout">
      <item>
       <widget class="QCheckBox" name="hideDisconnectedServersCheckbox">
        <property name="toolTip">
         <string>If you turn this on, disconnected servers will be hidden in the server list.</string>
        </property>
        <property name="text">
         <string>Hide disconnected servers</string>
        </property>
        <property name="shortcut">
         <string/>
        </property>
       </widget>
      </item>
      <item>
       <widget class="QCheckBox" name="hideBlacklistedServersCheckbox">
        <property name="toolTip">
         <string>If you turn this on, blacklisted servers will be hidden in the server list.</string>
        </property>
        <property name="text">
         <string>Hide blacklisted servers</string>
        </property>
       </widget>
      </item>
      <item>
       <layout class="QHBoxLayout">
        <item>
         <widget class="QCheckBox" name="autoServerResortCheckbox">
          <property name="text">
           <string>Automatically re-sort server list:</string>
          </property>
         </widget>
        </item>
        <item>
         <widget class="QSpinBox" name="serverResortEntry">
          <property name="enabled">
           <bool>false</bool>
          </property>
          <property name="toolTip">
           <string/>
          </property>
          <property name="value">
           <number>10</number>
          </property>
          <property name="suffix">
           <string> seconds</string>
          </property>
          <property name="minValue" stdset="0">
           <number>1</number>
          </property>
         </widget>
        </item>
       </layout>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="QGroupBox" name="groupBox4">
     <property name="title">
      <string>Download List</string>
     </property>
     <layout class="QVBoxLayout" name="verticalLayout_2">
      <item>
       <widget class="QCheckBox" name="progressbarCheckBox">
        <property name="text">
         <string>Display progress bar in percentage column</string>
        </property>
       </widget>
      </item>
      <item>
       <widget class="QCheckBox" name="hidePausedCheckbox">
        <property name="toolTip">
         <string>If you turn this on, paused downloads will be hidden in the download list.</string>
        </property>
        <property name="text">
         <string>Hide &amp;paused downloads</string>
        </property>
       </widget>
      </item>
      <item>
       <widget class="QCheckBox" name="hideUnpausedCheckbox">
        <property name="toolTip">
         <string>If you turn this on, only paused downloads will be shown in the download list - unless you also turn on &quot;Hide paused downloads,&quot; which will give you an empty list.</string>
        </property>
        <property name="text">
         <string>Show only paused downloads</string>
        </property>
       </widget>
      </item>
      <item>
       <widget class="QCheckBox" name="SortDownloadingFirstCheckBox">
        <property name="text">
         <string>Sort downloading files first</string>
        </property>
        <property name="shortcut">
         <string/>
        </property>
       </widget>
      </item>
      <item>
       <widget class="QCheckBox" name="SortPausedLastCheckBox">
        <property name="text">
         <string>Sort paused files last</string>
        </property>
       </widget>
      </item>
      <item>
       <layout class="QHBoxLayout">
        <item>
         <widget class="QCheckBox" name="autoDownloadResortCheckbox">
          <property name="text">
           <string>Automatically re-sort download list:</string>
