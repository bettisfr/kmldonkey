          <property name="minValue" stdset="0">
           <number>1</number>
          </property>
         </widget>
        </item>
       </layout>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="QGroupBox" name="groupBox2">
     <property name="title">
      <string>Upload Lists</string>
     </property>
     <layout class="QVBoxLayout" name="verticalLayout_3">
      <item>
       <layout class="QHBoxLayout">
        <item>
         <widget class="QCheckBox" name="autoUpdateCheckbox">
          <property name="toolTip">
           <string>The lists on the upload page can be updated manually (to save bandwidth) or automatically.</string>
          </property>
          <property name="text">
           <string>Automatically &amp;update upload lists:</string>
          </property>
